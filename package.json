{
  "name": "m2office",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "description": "中小企業向け AI エージェントシステム",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run db:up && concurrently -n api,worker,web -c blue,magenta,green \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:api": "npm -w @m2office/api run dev",
    "dev:worker": "npm -w @m2office/worker run dev",
    "dev:web": "npm -w @m2office/web run dev",
    "db:up": "docker compose up -d db && node scripts/wait-for-db.mjs",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "db:reset": "docker compose down -v && npm run db:up && npm run db:migrate && npm run db:seed",
    "typecheck": "tsc -b && tsc -p packages/web --noEmit",
    "test": "node scripts/check-headers.mjs && node scripts/check-help.mjs && node scripts/check-web-components.mjs && node --import tsx scripts/gen-tool-docs.mjs --check && node --import tsx --test packages/*/test/*.test.ts",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.mjs",
    "lint:headers": "node scripts/check-headers.mjs",
    "lint:help": "node scripts/check-help.mjs",
    "ext:validate": "node --import tsx scripts/validate-extension.mjs",
    "ext:pack": "node --import tsx scripts/pack-extension.mjs",
    "docs:manual-pdf": "python3 tools/pdf/build_manual.py",
    "docs:hr-manual-pdf": "python3 tools/pdf/build_manual.py hr-payroll",
    "docs:tools": "node --import tsx scripts/gen-tool-docs.mjs",
    "tenant:create": "node --env-file-if-exists=.env scripts/create-tenant.mjs",
    "dev:cert": "node scripts/dev-cert.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "ws": "^8.21.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
