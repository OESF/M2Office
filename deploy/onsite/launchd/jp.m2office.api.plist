<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- M2Office のapi（仕様書 第8.6.1節）。起動時に動かし、止まったら動かし直す。専用の利用者で動かす。セットアップのスクリプト（setup.sh）が 雛形の名前 を埋める -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>jp.m2office.api</string>
	<key>UserName</key>
	<string>_m2office</string>
	<key>WorkingDirectory</key>
	<string>{{RELEASE_DIR}}</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{NODE_BIN}}</string>
		<string>--env-file={{ENV_FILE}}</string>
		<string>{{RELEASE_DIR}}/server/api.js</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>{{DATA_DIR}}/logs/api.log</string>
	<key>StandardErrorPath</key>
	<string>{{DATA_DIR}}/logs/api.log</string>
</dict>
</plist>
