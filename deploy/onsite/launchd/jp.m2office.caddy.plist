<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- M2Office の入口（Caddy。仕様書 第8.6.2節）。443 番を受けるため root で起動する（Caddy の中で権限を落とさないため、ほかの役目は持たせない） -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>jp.m2office.caddy</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{CADDY_BIN}}</string>
		<string>run</string>
		<string>--config</string>
		<string>{{CADDYFILE}}</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>XDG_DATA_HOME</key>
		<string>{{DATA_DIR}}/caddy</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>{{DATA_DIR}}/logs/caddy-run.log</string>
	<key>StandardErrorPath</key>
	<string>{{DATA_DIR}}/logs/caddy-run.log</string>
</dict>
</plist>
