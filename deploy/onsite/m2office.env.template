# M2Office ローカルの形の環境変数（仕様書 第8.6節・第8.6.1節）。セットアップのスクリプト（setup.sh）が 雛形の名前 を埋め、秘密の値は機械の上で作る（運営は知らない）。
# このファイルは専用の利用者（_m2office）と管理者だけが読めるようにする。控えに入れるときは暗号化する（第8.6.5節）。
NODE_ENV=production
M2O_DEPLOYMENT=onsite
M2O_ONSITE_TENANT={{SUBDOMAIN}}
M2O_APP_ROOT={{RELEASE_DIR}}
APP_BASE_URL=https://{{HOST}}
COOKIE_SECURE=true
API_PORT={{API_PORT}}
DATABASE_URL=postgres://m2office_app:{{DB_APP_PASSWORD}}@127.0.0.1:{{DB_PORT}}/m2office
MIGRATION_DATABASE_URL=postgres://m2office:{{DB_OWNER_PASSWORD}}@127.0.0.1:{{DB_PORT}}/m2office
FILE_STORAGE_DIR={{DATA_DIR}}/files
# 控え（RAID とは別のディスク。第8.6.5節）と、Homebrew で入れた PostgreSQL の道具
M2O_BACKUP_DIR={{BACKUP_DIR}}
M2O_PG_BIN={{PG_BIN}}
M2O_MACHINE_DIR={{DATA_DIR}}/machine
M2OFFICE_SECRET_KEY={{SECRET_KEY}}
# Google（会社の OAuth クライアント。戻り先は https://{{HOST}}/v1/oauth/... 。管理者ページの「接続」でも登録できる）
GOOGLE_LOGIN_CLIENT_ID={{GOOGLE_LOGIN_CLIENT_ID}}
GOOGLE_LOGIN_CLIENT_SECRET={{GOOGLE_LOGIN_CLIENT_SECRET}}
GOOGLE_LOGIN_REDIRECT_URI=https://{{HOST}}/v1/oauth/google/login-callback
GOOGLE_OAUTH_REDIRECT_URI=https://{{HOST}}/v1/oauth/google/callback
CONNECTOR_MODE=google
# 推論。ローカル AI（社内の機械で動かす言語モデル）と、外部の AI（会社の方針で使う分）
LLM_PROVIDER=gemini
GEMINI_API_KEY={{GEMINI_API_KEY}}
LOCAL_LLM_URL={{LOCAL_LLM_URL}}
LOCAL_LLM_MODEL={{LOCAL_LLM_MODEL}}
# 知識の意味の検索の埋め込み（768 次元のモデル。仕様書 第11.7.6節）
LOCAL_LLM_EMBED_MODEL={{LOCAL_LLM_EMBED_MODEL}}
# 運営への稼働の知らせ（保守の契約に合わせて導入のときに決める。空なら送らない。仕様書 第8.6.8節）
M2O_HEARTBEAT_URL={{HEARTBEAT_URL}}
M2O_HEARTBEAT_TOKEN={{HEARTBEAT_TOKEN}}
M2O_MACHINE_ID={{MACHINE_ID}}
LOG_LEVEL=info
