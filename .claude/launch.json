{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3100,
      "url": "http://a.lvh.me:3100"
    },
    {
      "name": "dev-https",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "WEB_HTTPS=true",
        "npm",
        "run",
        "dev"
      ],
      "port": 3100,
      "url": "https://a.lvh.me:3100"
    },
    {
      "name": "web-http",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "WEB_HTTPS=false",
        "WEB_PORT=3104",
        "npm",
        "run",
        "dev",
        "-w",
        "packages/web"
      ],
      "port": 3104,
      "url": "http://a.localhost:3104"
    }
  ]
}
