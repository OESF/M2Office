# 依存
node_modules/

# ビルド成果物
dist/
# 本番の組み立て（npm run build:release）
dist-release/
*.tsbuildinfo

# 設定（秘密情報を含む。.env.example を雛形とする）
.env
.env.*
!.env.example

# 生成物
# specification.pdf は specification.md から作る。tools/pdf/ を参照
specification.pdf
# 開発者マニュアルの PDF は docs/developer/*.md から作る（npm run docs:manual-pdf）
docs/developer/developer-manual.pdf
# 人事・給与のユーザーマニュアルの PDF は docs/manual/hr-payroll/*.md から作る（npm run docs:hr-manual-pdf）
docs/manual/hr-payroll/hr-payroll-manual.pdf
# 在庫管理のユーザーマニュアルの PDF は docs/manual/inventory/*.md から作る（npm run docs:inventory-manual-pdf）
docs/manual/inventory/inventory-manual.pdf
# 人事・給与の監修のお願いの PDF は docs/review/hr-payroll/*.md から作る（npm run docs:hr-review-pdf）
docs/review/hr-payroll/hr-payroll-review.pdf
# マスター管理画面の運営者マニュアルの PDF は docs/ops-manual/*.md から作る（npm run docs:ops-manual-pdf）
docs/ops-manual/ops-manual.pdf
*.log

# エディタと OS
.DS_Store
.vscode/
.idea/

# Python の一時ファイル（tools/pdf）
__pycache__/
*.pyc

# Claude Code の個人設定（launch.json は共有する）
.claude/settings.local.json
.claude/*.local.json

# プレゼン資料（生成物。tools/deck で再生成する）
M2Office_プロダクト概要.pptx
M2Office_開発キックオフ.pptx

# 開発用のファイルの置き場（FILE_STORAGE_DIR の既定）
.data/
