# ポートは 3100 番台に統一する（3000・3001 は他プロジェクトが使用中）
WEB_PORT=3100
API_PORT=3101
WORKER_PORT=3102
DB_PORT=3105

# データベース
# アプリはこのロールで接続する。表の所有者ではなく、行レベルセキュリティを迂回できない
DATABASE_URL=postgres://m2office_app:m2office_app@localhost:3105/m2office
# スキーマ変更と初期データの投入に使う所有者のロール。アプリからは使わない
MIGRATION_DATABASE_URL=postgres://m2office:m2office@localhost:3105/m2office

# 開発用のベースドメイン。ワイルドカードで 127.0.0.1 に解決される
# 例: a.lvh.me:3100 で A 社のテナントに入る
BASE_DOMAIN=lvh.me

# LLM（B-3 で取得した鍵を設定する。鍵が無い会社では、秘書も業務も動かない。仕様書 第20.2.4節）
# LLM_PROVIDER=stub は自動テスト（npm run smoke）専用。推論を行わない
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# 役割ごとのモデル（仕様書 第20.2.2節）。既定は安いほうから選んでいる。
# 値段は packages/core/src/llm/models.ts の表に、出どころと確認日つきで書いてある。
#   高速   gemini-3.5-flash-lite  $0.30 / $2.50（振り分け・分類・夜の要約）
#   標準   gemini-3.5-flash-lite  $0.30 / $2.50（業務のステップ・秘書の対話）
#   高性能 gemini-3.8-flash       $0.75 / $3.75（いまは使っていない）
# 「…-latest」は新しい版が出ると中身が入れ替わり、試験中の版や高い版になることがある。
# 既定では使わない。設定すると起動のときに知らせる。
# MODEL_FAST=
# MODEL_STANDARD=
# MODEL_ADVANCED=
# Web の調査（web.research）に使うモデル。未設定なら MODEL_STANDARD
# MODEL_RESEARCH=
# 推論が混雑・障害などで失敗したときに最初に試す退避先（仕様書 第20.2.5節）。
# 未設定なら、上のほかの役割のモデルに退避する（同じ鍵の中だけ。最初を含めて 3 回まで）
# MODEL_FALLBACK=
# コラムの店頭サイネージ用の動画のモデル（仕様書 第32.18.6節）。未設定なら veo-3.1-lite-generate-preview
# MODEL_VIDEO=
# 画像を作るモデル（コラムのカバーとサイネージの挿絵・販促物の画像）。既定は gemini-nano-banana-2.1（Nano Banana 2.1）
# MODEL_IMAGE=
# 費用を円で示すときの為替（概算）。未設定なら 155
# USD_JPY=155

# 秘密の値（Gemini の鍵・OAuth のシークレット・利用者のトークン）を暗号化する鍵（ADR-0007）。
# 本番では必須。開発で未設定なら固定の鍵を使い、警告を出す。例: openssl rand -base64 32
# M2OFFICE_SECRET_KEY=
# 業務の接続で Google から戻る先（管理者ページに表示され、会社の OAuth クライアントに登録する）。
# 既定は http。WEB_HTTPS=true で動かすときは https にする（http の要求は受けないため。docs/google-setup.md 5-4）
# GOOGLE_OAUTH_REDIRECT_URI=https://localhost:3100/v1/oauth/google/callback
# 認証の要る会社の接続（Slack など）で相手のサービスから戻る先（仕様書 第12.11.6節）。管理者ページに表示され、相手のアプリに登録する。
# 既定は GOOGLE_OAUTH_REDIRECT_URI と同じホストの /v1/oauth/connection/callback。Slack は https の戻り先だけを認める
# CONNECTION_OAUTH_REDIRECT_URI=https://localhost:3100/v1/oauth/connection/callback
# 販促物の作成の Canva とのつなぎ（仕様書 第41.19.3節）。運営が Canva に公開のつなぎを登録し、審査を通してから入れる。
# 無ければ Canva のことは何も出さない。戻り先の既定は GOOGLE_OAUTH_REDIRECT_URI と同じホストの /v1/oauth/canva/callback
# CANVA_CLIENT_ID=
# CANVA_CLIENT_SECRET=
# CANVA_OAUTH_REDIRECT_URI=https://localhost:3100/v1/oauth/canva/callback
# 開発と自動テストで、Canva の代わりに見本を使う（外には何も送らない）
# CANVA_MOCK=true
# 音声（Gemini Live）のモデル
# MODEL_LIVE=gemini-3.1-flash-live-preview

# ログインに使う「運営の」OAuth クライアント（仕様書 第16.1.1節）。
# 求める権限は openid・email・profile だけ。Google のデータには触れない。
# 未設定なら Google ログインは無効（開発用ログインだけが残る）。
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
# Google に登録するリダイレクト URI。運営のホスト 1 本である（第16.1.2節）。
# Google は HTTPS を要求する（例外は localhost）ため、開発では localhost を使う。
# 未設定なら http://localhost:<API_PORT>/v1/oauth/google/login-callback
# GOOGLE_LOGIN_REDIRECT_URI=

# Google 連携（会社ごとの OAuth クライアント。管理者ページの接続で登録する。
# 下の 2 つは開発の既定値としてのみ使う。未設定なら連携機能は無効）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 業務システムへの接続（mock: ダミーデータ / google: Google Workspace）
# google は Gmail とカレンダーが本物。ほかのサービスは「準備中」と断る（仕様書 第14.3.4節、ADR-0022）
CONNECTOR_MODE=mock
# 開発だけ: google のとき、見本のまま動かす会社（テナント ID をカンマ区切り）。smoke の会社を見本に保つ。
# 本番（NODE_ENV=production）で設定すると起動を拒否する
# CONNECTOR_MOCK_TENANTS=t-alpha,t-beta

# 認証。正式なログインは Google アカウントのみ（仕様書 第16.1節）
# 以下の 2 つは開発用の足場。NODE_ENV=production で有効にすると起動を拒否する
# AUTH_DEV_LOGIN: 利用者を選んでログインする画面
# AUTH_DEV_HEADERS: X-Tenant / X-User ヘッダーでの指定（動作確認スクリプト用）
AUTH_DEV_LOGIN=true
AUTH_DEV_HEADERS=true
# デバッグモード（開発用の足場。仕様書 第20.4.1節）。画面の上に「Debug mode」を出し、音声・秘書の振り分け・失敗した呼び出しを記録して見せる。
# 記録はメモリーにだけ持つ。NODE_ENV=production で有効にすると起動を拒否する
# M2O_DEBUG=true
SESSION_TTL_HOURS=168
# HTTPS で配信する環境では true にする
COOKIE_SECURE=false

# 通知の控え（Chat・メール）に載せる画面のアドレス。{tenant} をサブドメインに置き換える
# 未設定なら http://{tenant}.<BASE_DOMAIN>:<WEB_PORT>
# APP_BASE_URL=https://{tenant}.m2office.online
# 通知の控えの見回り間隔（ミリ秒）
# NOTIFY_INTERVAL_MS=10000

# 定時実行の見回り間隔（ミリ秒）
SCHEDULE_INTERVAL_MS=15000
# 秘書の先回り（会議の直前の準備・前日の移動の知らせ）の見回り間隔（ミリ秒）。既定 10 分（仕様書 第10.12節）
# PROACTIVE_INTERVAL_MS=600000
# 期限を過ぎた名刺（ごみ箱に 30 日・読み取れなかったもの 4 週）を消す見回りの間隔（ミリ秒）。既定 1 時間（仕様書 第27.7節）
# CARD_PURGE_INTERVAL_MS=3600000
# 名刺を交換した相手のメールの署名を見て、名刺を新しくする見回りの間隔（ミリ秒）。既定 1 時間（仕様書 第27.6.1節）
# SIGNATURE_INTERVAL_MS=3600000
# 問い合わせの期限と手つかずを知らせ、古い原文を消す見回りの間隔（ミリ秒）。既定 15 分（仕様書 第33.17節）
# INQUIRY_INTERVAL_MS=900000
# 問い合わせの窓口のアカウントのメールを読む間隔（ミリ秒）。既定 5 分（仕様書 第33.18節）
# INQUIRY_MAIL_INTERVAL_MS=300000
# 競合の分析の作業（探す・読む）を見る間隔（ミリ秒）。既定 10 秒（仕様書 第36.18節）
# COMPETITOR_INTERVAL_MS=10000
# お知らせの予約の時刻と期間の後を見回る間隔（ミリ秒）。既定 1 分（仕様書 第35.17節）
# ANNOUNCEMENT_INTERVAL_MS=60000
# 契約の解約の申し出の期限と終わりを見張る間隔（ミリ秒。既定 1 時間。仕様書 第38.6節）
# CONTRACT_INTERVAL_MS=3600000
# 補助金・助成金の月の調べもの（毎月 1 日の 8 時を過ぎたら）と、締め切りの知らせを見る間隔（ミリ秒。仕様書 第39.7節）
# SUBSIDY_INTERVAL_MS=3600000
# Webの分析を見回る間隔（ミリ秒。既定 1 分。毎月 3 日の 8 時を過ぎたら先月の便りを 1 回だけ作り、週に 1 回と「今すぐチェック」で直すべき所を探す。仕様書 第34.18節・第34.19節）
# WEB_REVIEW_INTERVAL_MS=60000
# PageSpeed Insights の運営の鍵（任意。無ければ鍵なしの回数の範囲で呼ぶ。Q-174）
# PAGESPEED_API_KEY=
# コラムの作成の予約・予定表・テーマ案を見回る間隔（ミリ秒。既定 1 分。仕様書 第32.18.4節）
# COLUMN_PLAN_INTERVAL_MS=60000
# 競合の分析が相手のサイトを読むときに名乗る問い合わせ先の URL（運営主体の案内のページ。仕様書 第36.7節）。空なら付けない
# CRAWLER_CONTACT_URL=

# 配備の形（仕様書 第8.6節）。cloud（多数の会社・サブドメイン）か onsite（社内の 1 台に 1 社だけ。ローカルの形）
# M2O_DEPLOYMENT=cloud
# ローカルの形で入っている 1 社のサブドメイン
# M2O_ONSITE_TENANT=
# ローカル AI（社内の機械で動かす言語モデル）の OpenAI 互換の口とモデル（仕様書 第16.3.7.1節）
# LOCAL_LLM_URL=http://127.0.0.1:11434/v1
# LOCAL_LLM_MODEL=gemma3
# LOCAL_LLM_TIMEOUT_MS=300000
# 在庫の毎朝の見直しを始める時刻（日本時間の時。仕様書 第29.14節）
# INVENTORY_WATCH_HOUR=7

# Google から取得したデータの保持期間の見回り間隔（ミリ秒）。未設定なら本番 10 分、開発 15 秒
# RETENTION_INTERVAL_MS=15000

# ファイルの置き場（開発用）。未設定ならリポジトリ直下の .data/files
# FILE_STORAGE_DIR=

# アプリログ（開発規約 第7章）
# LOG_LEVEL: error / warn / info / debug。未設定なら開発は debug、本番は info
# LOG_FORMAT: pretty（人が読む形）/ json。未設定なら開発は pretty、本番は json
# LOG_LEVEL=debug
# 画面が数秒ごとに読み直す要求も 1 件ずつ記録するか（既定は、成功して 1 秒より速いものを書かない）
# LOG_POLLS=false
# LOG_FORMAT=pretty
