# ポートは 3100 番台に統一する（3000・3001 は他プロジェクトが使用中）
WEB_PORT=3100
API_PORT=3101
WORKER_PORT=3102
DB_PORT=3105

# データベース
DATABASE_URL=postgres://m2office:m2office@localhost:3105/m2office

# 開発用のベースドメイン。ワイルドカードで 127.0.0.1 に解決される
# 例: a.lvh.me:3100 で A 社のテナントに入る
BASE_DOMAIN=lvh.me

# LLM（B-3 で取得した鍵を設定する。未設定ならスタブで動作する）
LLM_PROVIDER=stub
GEMINI_API_KEY=

# Google 連携（B-2 で作成した開発用 OAuth クライアント。未設定なら連携機能は無効）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
