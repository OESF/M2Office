# ポートは 3100 番台に統一する（3000・3001 は他プロジェクトが使用中）
WEB_PORT=3100
API_PORT=3101
WORKER_PORT=3102
DB_PORT=3105

# データベース
# アプリはこのロールで接続する。表の所有者ではなく、行レベルセキュリティを迂回できない
DATABASE_URL=postgres://m2office_app:m2office_app@localhost:3105/m2office
# スキーマ変更と初期データの投入に使う所有者のロール。アプリからは使わない
MIGRATION_DATABASE_URL=postgres://m2office:m2office@localhost:3105/m2office

# 開発用のベースドメイン。ワイルドカードで 127.0.0.1 に解決される
# 例: a.lvh.me:3100 で A 社のテナントに入る
BASE_DOMAIN=lvh.me

# LLM（B-3 で取得した鍵を設定する。未設定ならスタブで動作する）
LLM_PROVIDER=stub
GEMINI_API_KEY=

# 役割ごとのモデル（仕様書 第20.2.2節）。既定は安いほうから選んでいる。
# 値段は packages/core/src/llm/models.ts の表に、出どころと確認日つきで書いてある。
#   高速   gemini-3.5-flash-lite  $0.30 / $2.50（振り分け・分類・夜の要約）
#   標準   gemini-3.5-flash-lite  $0.30 / $2.50（業務のステップ・秘書の対話）
#   高性能 gemini-3.8-flash       $0.75 / $3.75（いまは使っていない）
# 「…-latest」は新しい版が出ると中身が入れ替わり、試験中の版や高い版になることがある。
# 既定では使わない。設定すると起動のときに知らせる。
# MODEL_FAST=
# MODEL_STANDARD=
# MODEL_ADVANCED=
# Web の調査（web.research）に使うモデル。未設定なら MODEL_STANDARD
# MODEL_RESEARCH=
# 費用を円で示すときの為替（概算）。未設定なら 155
# USD_JPY=155

# 秘密の値（Gemini の鍵・OAuth のシークレット・利用者のトークン）を暗号化する鍵（ADR-0007）。
# 本番では必須。開発で未設定なら固定の鍵を使い、警告を出す。例: openssl rand -base64 32
# M2OFFICE_SECRET_KEY=
# 業務の接続で Google から戻る先（管理者ページに表示され、会社の OAuth クライアントに登録する）
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3100/v1/oauth/google/callback
# 音声（Gemini Live）のモデル
# MODEL_LIVE=gemini-3.1-flash-live-preview

# ログインに使う「運営の」OAuth クライアント（仕様書 第16.1.1節）。
# 求める権限は openid・email・profile だけ。Google のデータには触れない。
# 未設定なら Google ログインは無効（開発用ログインだけが残る）。
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
# Google に登録するリダイレクト URI。運営のホスト 1 本である（第16.1.2節）。
# Google は HTTPS を要求する（例外は localhost）ため、開発では localhost を使う。
# 未設定なら http://localhost:<API_PORT>/v1/oauth/google/login-callback
# GOOGLE_LOGIN_REDIRECT_URI=

# Google 連携（会社ごとの OAuth クライアント。管理者ページの接続で登録する。
# 下の 2 つは開発の既定値としてのみ使う。未設定なら連携機能は無効）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 業務システムへの接続（mock: ダミーデータ / google: Google Workspace）
# Google は B-2 の完了後に実装する。それまでは mock で骨格を動かす
CONNECTOR_MODE=mock

# 認証。正式なログインは Google アカウントのみ（仕様書 第16.1節）
# 以下の 2 つは開発用の足場。NODE_ENV=production で有効にすると起動を拒否する
# AUTH_DEV_LOGIN: 利用者を選んでログインする画面
# AUTH_DEV_HEADERS: X-Tenant / X-User ヘッダーでの指定（動作確認スクリプト用）
AUTH_DEV_LOGIN=true
AUTH_DEV_HEADERS=true
SESSION_TTL_HOURS=168
# HTTPS で配信する環境では true にする
COOKIE_SECURE=false

# 通知の控え（Chat・メール）に載せる画面のアドレス。{tenant} をサブドメインに置き換える
# 未設定なら http://{tenant}.<BASE_DOMAIN>:<WEB_PORT>
# APP_BASE_URL=https://{tenant}.m2office.online
# 通知の控えの見回り間隔（ミリ秒）
# NOTIFY_INTERVAL_MS=10000

# 定時実行の見回り間隔（ミリ秒）
SCHEDULE_INTERVAL_MS=15000

# Google から取得したデータの保持期間の見回り間隔（ミリ秒）。未設定なら本番 10 分、開発 15 秒
# RETENTION_INTERVAL_MS=15000

# ファイルの置き場（開発用）。未設定ならリポジトリ直下の .data/files
# FILE_STORAGE_DIR=

# アプリログ（開発規約 第7章）
# LOG_LEVEL: error / warn / info / debug。未設定なら開発は debug、本番は info
# LOG_FORMAT: pretty（人が読む形）/ json。未設定なら開発は pretty、本番は json
# LOG_LEVEL=debug
# LOG_FORMAT=pretty
